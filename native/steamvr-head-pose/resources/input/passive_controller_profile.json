{
  "jsonid": "input_profile",
  "controller_type": "vive_controller",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "codex_head_pose",
  "driver_name": "codex_head_pose",
  "legacy_binding": "{htc}/input/legacy_bindings_vive_controller.json",
  "input_bindingui_mode": "controller_handed",
  "input_source": {
    "/input/system": { "type": "button", "click": true },
    "/input/application_menu": { "type": "button", "click": true },
    "/input/grip": { "type": "button", "click": true },
    "/input/trackpad": { "type": "trackpad", "click": true, "touch": true },
    "/input/trigger": { "type": "trigger", "click": true, "value": true },
    "/pose/raw": { "type": "pose" },
    "/output/haptic": { "type": "vibration" }
  }
}
